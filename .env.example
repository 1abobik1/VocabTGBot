# Copy to .env for running scripts locally. GitHub Actions reads these from repo secrets.
TELEGRAM_BOT_TOKEN=
# Cloudflare API token with "Workers KV Storage: Edit" only
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
# random string, must match the Worker secret of the same name (used by scripts/set_webhook.py)
TELEGRAM_WEBHOOK_SECRET=
# your Telegram username without @ (Worker secret OWNER_USERNAME)
OWNER_USERNAME=
# адрес задеплоенного воркера, например https://vocab-bot.<поддомен>.workers.dev
WORKER_URL=
